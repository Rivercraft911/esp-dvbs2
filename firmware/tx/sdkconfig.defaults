# ESP32-S3 with 8 MB embedded octal PSRAM (S3R8) and 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Boot and report psram_bytes = 0 instead of aborting if the PSRAM is missing.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Commands and results over the chip's own USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000

# Required vendor force-TX/gain entry points for the radio experiment.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y

# The PHY comes up once at boot without Wi-Fi (radio_s3_init) and calibrates fully then;
# no PHY cache reads or writes.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Only the spisend test sender uses the SPI master. RX DMA callbacks stay in IRAM.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
# Run memory comes from fixed arenas (main/run_memory.c), not the heap. The heap hooks count
# any heap call after boot (info: heap_after_boot). Keep the allocator in flash rather than
# spending shared instruction/data RAM.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_HEAP_USE_HOOKS=y
# Core 1 belongs to the radio worker, which holds that core's task-watchdog subscription
# (radio_s3.c); its idle task never runs during a run.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
