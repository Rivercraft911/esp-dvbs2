# ESP32-S3 with 8 MB embedded octal PSRAM (S3R8) and 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Boot and report psram_bytes = 0 instead of aborting if the PSRAM is missing.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Commands and results over the chip's own USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000

# Required vendor force-TX/gain entry points for the radio experiment.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y

# Full calibration each run; no PHY cache reads or writes during this experiment.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# Wi-Fi only powers the radio here (NULL mode, no traffic), so give its RAM back to the
# transmitter: few RX buffers, no aggregation, its code in flash, allocations in PSRAM.
# Without this, Wi-Fi start-up failed with ESP_ERR_NO_MEM next to the encoder and station ID
# (results/2026-10-16-keyed-box).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Only the diagnostic loopback uses the SPI master. RX DMA callbacks stay in IRAM.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
# Allocate before streaming and free after stopping. The encoder, bank fill and
# SPI ISRs never allocate (PV uses internal DMA buffers and NO_RETURN_RESULT).
# Keep the allocator in flash rather than spending shared instruction/data RAM.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# Measure the sender separately from encoder preemption. Counters are in microseconds.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
