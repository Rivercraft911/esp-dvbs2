# ESP32-S3 with 8 MB octal PSRAM. 8 MB flash fits both the N16R8 and the XIAO.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000

# Vendor gain and tone entry points; full calibration at boot, no PHY storage.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n

# The PHY comes up without Wi-Fi (capture.c); heap code stays in flash to leave IRAM free.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# Core 1 belongs to the capture loop for the whole run; its idle task never runs.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# The handoff interrupt and its alarm updates stay in IRAM.
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
