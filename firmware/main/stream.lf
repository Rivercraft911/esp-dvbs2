# The fill wakes the encoder from task context. Keep the notification's normal
# path in IRAM; its critical-section and cross-core-yield callees are already there.
[mapping:stream_notify]
archive: libfreertos.a
entries:
    tasks:xTaskGenericNotify (noflash_text)
    tasks:vTaskGenericNotifyGiveFromISR (noflash_text)

# Only 8PSK 26m667 loads and locks this control code in instruction cache.
# Keep the vector renderer in IRAM. All custom literals precede the code.
[sections:lofty_cache_index]
entries:
    .loft0

[scheme:lofty_cache_index]
entries:
    lofty_cache_index -> flash_text

[mapping:lofty_cache_index]
archive: libmain.a
entries:
    * (lofty_cache_index);
        lofty_cache_index -> flash_text ALIGN(4096, pre) KEEP()

[sections:lofty_text]
entries:
    .lofty.literal
    .lofty

[scheme:lofty_text]
entries:
    lofty_text -> flash_text

[mapping:lofty_text]
archive: libmain.a
entries:
    * (lofty_text);
        lofty_text -> flash_text ALIGN(32, pre, post) SURROUND(lofty_text)

# The optional renderer locks its own region, never the default region too.
[sections:lofty_fused_text]
entries:
    .lofty_fused.literal
    .lofty_fused

[scheme:lofty_fused_text]
entries:
    lofty_fused_text -> flash_text

[mapping:lofty_fused_text]
archive: libmain.a
entries:
    * (lofty_fused_text);
        lofty_fused_text -> flash_text ALIGN(32, pre, post) SURROUND(lofty_fused_text)

[sections:vcm_bss]
entries:
    .vcm_bss

[scheme:vcm_bss]
entries:
    vcm_bss -> dram0_bss

[mapping:vcm_bss]
archive: libmain.a
entries:
    * (vcm_bss)
